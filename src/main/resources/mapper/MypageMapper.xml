<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.demo.mapper.MypageMapper">

    <resultMap id="UserWithJobResultMap"
        type="com.example.demo.entity.User">

        <id property="id" column="id" />

        <result property="name" column="user_name" />
        <result property="email" column="email" />
        <result property="level" column="level" />
        <result property="job_id" column="job_id" />
        <result property="prefecture_id" column="prefecture_id" />
        <result property="role" column="role" />

        <association property="job"
            javaType="com.example.demo.entity.Job">

            <id property="id" column="job_id" />
            <result property="name" column="job_name" />
            <result property="imagePath" column="image_path" />

        </association>

    </resultMap>

    <select id="findByUserId"
        resultMap="UserWithJobResultMap">

        SELECT
            u.id,
            u.name AS user_name,
            u.email,
            u.level,
            u.job_id,
            u.prefecture_id,
            u.role,

            j.name AS job_name,
            j.image_path

        FROM users u

        JOIN jobs j
        ON u.job_id = j.id

        WHERE u.id = #{id}

    </select>

</mapper>